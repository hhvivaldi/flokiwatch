# ============================================================================
# FlokiWatch XAUUSD Trading Bot - .gitignore
# ============================================================================

# Environment variables (API keys, credentials)
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# ============================================================================
# LOGS (runtime logs - regenerated each session)
# ============================================================================
logs/

# ============================================================================
# DATA (runtime state, databases, large files)
# ============================================================================
data/history.db
data/bot_state.json
data/agent_session_memory.json
data/agent_session_memory_*.json
data/agent_watch_conditions.json
data/*.csv
data/*.txt
data/*.json

# Allow committing Sage schema only. sage_report.json is runtime state —
# tracking it in git caused FLO-303: Apr 18 git reset reverted the file
# to a 20-day-old committed version.
!data/sage_report.schema.json

# ChromaDB vector store (runtime, regenerated from SQLite)
data/chromadb/

# Trade conditions snapshots (per-ticket, regenerated)
data/trade_conditions/

# Database backups
data/*.bak*

# JSONL analysis dumps
data/*.jsonl

# ============================================================================
# MODELS (binary files - regenerated from training scripts)
# ============================================================================
models/*.pkl
models/*.keras
models/*.cbm
models/*.txt
models_v3_backup/

# Training artifacts
catboost_info/

# ============================================================================
# DRY RUN REPORTS (test outputs)
# ============================================================================
dry_run_report_*.txt

# ============================================================================
# BROWSER SAVES / MISC
# ============================================================================
*.mhtml
ngrok.exe

# Cloned repos (installed via git clone, not project code)
claude-frontend-skills/

# Temporary scripts
tmp_*.py
check_*.py

# Zip archives
*.zip

# OS
.DS_Store
Thumbs.db
