# FlokiWatch XAUUSD Trading Bot - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================================
# MT5 ACCOUNT (REQUIRED)
# ============================================================================
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=ICMarkets-Demo
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ============================================================================
# DISCORD WEBHOOK (REQUIRED for notifications)
# ============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_SIGNALS=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_DASHBOARD=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_BRAIN=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_TRADES=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_STATUS=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_DAILY=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_WEEKLY=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_MONTHLY=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_BACKTEST=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_ERRORS=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_CHANGELOG=https://discord.com/api/webhooks/your_webhook_here

# ============================================================================
# OPENAI API KEY (REQUIRED for GPT headline analysis)
# ============================================================================
OPENAI_API_KEY=sk-your_openai_key_here

# ============================================================================
# ANTHROPIC API KEY (REQUIRED for AI Agent)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ============================================================================
# OPTIONAL API KEYS
# ============================================================================
FRED_API_KEY=
FCS_API_KEY=
SAGE_API_KEY=

# ============================================================================
# MT5 FILE PATHS (machine-specific, optional overrides)
# ============================================================================
# CALENDAR_JSON_PATH=C:\Users\YourUser\AppData\Roaming\MetaQuotes\Terminal\YOUR_TERMINAL_ID\MQL5\Files\calendar_events.json
# SR_ZONES_JSON_PATH=C:\Users\YourUser\AppData\Roaming\MetaQuotes\Terminal\YOUR_TERMINAL_ID\MQL5\Files\sr_zones.json
